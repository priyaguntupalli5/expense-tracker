# Copy this file to deployment/.env and fill in your values.
# deployment/.env is gitignored — never commit real secrets.

DB_URL=jdbc:mysql://<RDS-ENDPOINT>:3306/expensetracker?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USER=admin
DB_PASS=your-rds-password
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
